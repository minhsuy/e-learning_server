generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// ENUMS
// ==========================================

enum UserRole {
  ADMIN   @map("admin")
  USER    @map("user")
  TEACHER @map("teacher")
}

enum UserStatus {
  ACTIVE   @map("active")
  INACTIVE @map("inactive")
}

enum CourseStatus {
  APPROVED @map("approved")
  PENDING  @map("pending")
  REJECTED @map("rejected")
}

enum CourseLevel {
  BEGINNER     @map("beginner")
  INTERMEDIATE @map("intermediate")
  ADVANCED     @map("advanced")
}

enum CourseType {
  PAID @map("paid")
  FREE @map("free")
}

enum LessonType {
  VIDEO @map("video")
  TEXT  @map("text")
}

enum ECouponType {
  PERCENTAGE @map("percentage")
  NUMBER     @map("number")
}

enum EOrderStatus {
  PENDING   @map("pending")
  COMPLETED @map("completed")
  REJECTED  @map("rejected")
}

enum EEnrollmentStatus {
  ACTIVE    @map("active")
  COMPLETED @map("completed")
  CANCELED  @map("canceled")
}

enum CommentStatus {
  APPROVED @map("approved")
  PENDING  @map("pending")
  REJECTED @map("rejected")
  HIDDEN   @map("hidden")
  FLAGGED  @map("flagged")
}

enum ERatingStatus {
  ACTIVE   @map("active")
  INACTIVE @map("inactive")
}

enum ENotificationType {
  COMMENT       @map("comment")
  RATING        @map("rating")
  ORDER         @map("order")
  MESSAGE       @map("message")
  SYSTEM        @map("system")
  COURSE        @map("course")
  LESSON        @map("lesson")
  COMMENT_REPLY @map("comment_reply")
  QUIZ          @map("quiz")
}

enum QuestionType {
  MULTIPLE_CHOICE @map("multiple_choice")
  FILL_IN_BLANK   @map("fill_in_blank")
}

enum EMessageType {
  TEXT  @map("text")
  IMAGE @map("image")
  FILE  @map("file")
}

enum CommentReactionType {
  LIKE    @map("like")
  DISLIKE @map("dislike")
}

enum XPTransactionType {
  LESSON_COMPLETED          @map("lesson_completed")
  QUIZ_COMPLETED            @map("quiz_completed")
  DAILY_STREAK              @map("daily_streak")
  CODING_EXERCISE_COMPLETED @map("coding_exercise_completed")
}

enum ExerciseDifficulty {
  EASY   @map("easy")
  MEDIUM @map("medium")
  HARD   @map("hard")
}

enum ExerciseStatus {
  DRAFT     @map("draft")
  PUBLISHED @map("published")
  ARCHIVED  @map("archived")
}

enum ExerciseSource {
  MANUAL @map("manual")
  AI     @map("ai")
}

enum SubmissionStatus {
  PENDING               @map("pending")
  RUNNING               @map("running")
  ACCEPTED              @map("accepted")
  WRONG_ANSWER          @map("wrong_answer")
  TIME_LIMIT_EXCEEDED   @map("time_limit_exceeded")
  MEMORY_LIMIT_EXCEEDED @map("memory_limit_exceeded")
  RUNTIME_ERROR         @map("runtime_error")
  COMPILATION_ERROR     @map("compilation_error")
  INTERNAL_ERROR        @map("internal_error")
}

enum TestCaseStatus {
  PASSED                @map("passed")
  FAILED                @map("failed")
  TIME_LIMIT_EXCEEDED   @map("time_limit_exceeded")
  MEMORY_LIMIT_EXCEEDED @map("memory_limit_exceeded")
  RUNTIME_ERROR         @map("runtime_error")
  COMPILATION_ERROR     @map("compilation_error")
  INTERNAL_ERROR        @map("internal_error")
}

enum AiProcessingStatus {
  PENDING    @map("pending")
  PROCESSING @map("processing")
  COMPLETED  @map("completed")
  FAILED     @map("failed")

  @@map("ai_processing_status")
}

enum AiJobType {
  TRANSCRIBE_AND_SUMMARIZE @map("transcribe_and_summarize")
  TRANSCRIBE               @map("transcribe")
  SUMMARIZE                @map("summarize")
  GENERATE_QUIZ            @map("generate_quiz")
  GENERATE_CODING_EXERCISE @map("generate_coding_exercise")

  @@map("ai_job_types")
}

enum AiJobStatus {
  PENDING    @map("pending")
  SUBMITTING @map("submitting")
  QUEUED     @map("queued")
  RUNNING    @map("running")
  COMPLETED  @map("completed")
  FAILED     @map("failed")
  STALE      @map("stale")

  @@map("ai_job_statuses")
}

// ==========================================
// MODELS
// ==========================================

model User {
  id                   String     @id @default(uuid()) @db.Uuid
  username             String     @db.VarChar(100)
  email                String     @unique @db.VarChar(255)
  password             String     @db.VarChar(255)
  status               UserStatus @default(ACTIVE)
  role                 UserRole   @default(USER)
  avatar               String     @default("")
  phone                String?    @db.VarChar(30)
  bio                  String?    @db.Text
  socialFacebook       String     @default("") @map("social_facebook")
  socialInstagram      String     @default("") @map("social_instagram")
  socialGithub         String     @default("") @map("social_github")
  isVerified           Boolean    @default(false) @map("is_verified")
  otpCode              String?    @map("otp_code") @db.VarChar(255)
  otpExpires           DateTime?  @map("otp_expires")
  refreshToken         String?    @map("refresh_token") @db.Text
  resetPasswordToken   String?    @map("reset_password_token") @db.Text
  resetPasswordExpires DateTime?  @map("reset_password_expires")
  createdAt            DateTime   @default(now()) @map("created_at")
  updatedAt            DateTime   @updatedAt @map("updated_at")

  // XP, Streak & Gamification Foundation
  xpTotal        Int       @default(0) @map("xp_total")
  currentStreak  Int       @default(0) @map("current_streak")
  longestStreak  Int       @default(0) @map("longest_streak")
  lastActivityAt DateTime? @map("last_activity_at")

  // Relations
  createdCategories     Category[]                 @relation("CategoryCreatedBy")
  authoredCourses       Course[]                   @relation("CourseAuthor")
  authoredLessons       Lesson[]                   @relation("LessonAuthor")
  createdQuizzes        Quiz[]                     @relation("QuizCreatedBy")
  quizSubmissions       QuizSubmission[]
  orders                Order[]
  authoredCoupons       Coupon[]                   @relation("CouponAuthor")
  enrollments           Enrollment[]
  progress              Progress[]
  certificates          Certificate[]
  ratings               Rating[]
  comments              Comment[]
  commentReactions      CommentReaction[]
  favoriteCourses       FavoriteCourse[]
  conversations         ConversationParticipant[]
  sentMessages          Message[]                  @relation("MessageSender")
  messageReads          MessageRead[]
  sentNotifications     Notification[]             @relation("NotificationSender")
  receivedNotifications Notification[]             @relation("NotificationReceiver")
  xpTransactions        XPTransaction[]
  videoUploads          VideoUpload[]
  codingExercises       CodingExercise[]           @relation("CodingExerciseCreatedBy")
  codingRevisions       CodingExerciseRevision[]   @relation("CodingRevisionCreatedBy")
  codingSubmissions     CodingSubmission[]
  codingCompletions     CodingExerciseCompletion[]
  requestedAiJobs       AiProcessingJob[]          @relation("UserRequestedAiJobs")
  telegramAccount       TelegramAccount?
  telegramLinkTokens    TelegramLinkToken[]

  @@index([role])
  @@index([status])
  @@index([isVerified])
  @@index([xpTotal])
  @@map("users")
}

model XPTransaction {
  id        String            @id @default(uuid()) @db.Uuid
  userId    String            @map("user_id") @db.Uuid
  amount    Int
  type      XPTransactionType
  eventKey  String            @unique @map("event_key") @db.VarChar(255)
  createdAt DateTime          @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, type, createdAt])
  @@map("xp_transactions")
}

model Category {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique @db.VarChar(200)
  slug        String   @unique @db.VarChar(250)
  description String?  @db.Text
  createdById String?  @map("created_by_id") @db.Uuid
  isDestroyed Boolean  @default(false) @map("is_destroyed")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  createdBy User?    @relation("CategoryCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  courses   Course[]

  @@map("categories")
}

model Course {
  id              String       @id @default(uuid()) @db.Uuid
  title           String       @db.VarChar(255)
  slug            String       @unique @db.VarChar(255)
  image           String       @default("")
  introUrl        String       @default("") @map("intro_url")
  description     String       @default("") @db.Text
  price           Decimal      @default(0) @db.Decimal(12, 2)
  oldPrice        Decimal      @default(0) @map("old_price") @db.Decimal(12, 2)
  type            CourseType   @default(PAID)
  status          CourseStatus @default(PENDING)
  level           CourseLevel  @default(BEGINNER)
  view            Int          @default(0)
  sold            Int          @default(0)
  requirements    String[]     @default([])
  benefits        String[]     @default([])
  techniques      String[]     @default([])
  documents       String[]     @default([])
  categoryId      String?      @map("category_id") @db.Uuid
  authorId        String       @map("author_id") @db.Uuid
  isDestroyed     Boolean      @default(false) @map("is_destroyed")
  rejectionReason String?      @map("rejection_reason") @db.Text
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  category        Category?         @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  author          User              @relation("CourseAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  faqs            CourseFaq[]
  chapters        Chapter[]
  lessons         Lesson[]
  quizzes         Quiz[]
  orders          Order[]
  coupons         CouponCourse[]
  enrollments     Enrollment[]
  progress        Progress[]
  certificates    Certificate[]
  ratings         Rating[]
  comments        Comment[]
  favoriteByUsers FavoriteCourse[]
  conversations   Conversation[]
  videoUploads    VideoUpload[]
  codingExercises CodingExercise[]
  aiJobs          AiProcessingJob[]

  @@index([authorId])
  @@index([categoryId])
  @@index([status, isDestroyed])
  @@map("courses")
}

model CourseFaq {
  id        String   @id @default(uuid()) @db.Uuid
  courseId  String   @map("course_id") @db.Uuid
  question  String   @db.Text
  answer    String   @db.Text
  order     Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([courseId, order])
  @@map("course_faqs")
}

model Chapter {
  id          String   @id @default(uuid()) @db.Uuid
  title       String   @db.VarChar(255)
  courseId    String   @map("course_id") @db.Uuid
  order       Int      @default(0)
  isDestroyed Boolean  @default(false) @map("is_destroyed")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  course  Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons Lesson[]

  @@index([courseId, order])
  @@map("chapters")
}

model Lesson {
  id                 String              @id @default(uuid()) @db.Uuid
  title              String              @db.VarChar(255)
  slug               String              @db.VarChar(255)
  chapterId          String              @map("chapter_id") @db.Uuid
  courseId           String              @map("course_id") @db.Uuid
  authorId           String              @map("author_id") @db.Uuid
  order              Int                 @default(0)
  duration           Int                 @default(0)
  type               LessonType          @default(VIDEO)
  content            String              @default("") @db.Text
  isDemo             Boolean             @default(false) @map("is_demo")
  videoUrl           String              @default("") @map("video_url")
  bunnyVideoId       String?             @unique @map("bunny_video_id") @db.VarChar(100)
  videoStatus        String?             @default("READY") @map("video_status") @db.VarChar(50)
  transcript         String?             @db.Text
  transcriptOriginal String?             @map("transcript_original") @db.Text
  transcriptRefined  String?             @map("transcript_refined") @db.Text
  summary            String?             @db.Text
  aiProcessingStatus AiProcessingStatus? @default(PENDING) @map("ai_processing_status")
  aiProcessedAt      DateTime?           @map("ai_processed_at")
  aiProcessingError  String?             @map("ai_processing_error") @db.Text
  aiGeneration       Int                 @default(1) @map("ai_generation")
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")

  chapter         Chapter           @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  course          Course            @relation(fields: [courseId], references: [id], onDelete: Cascade)
  author          User              @relation("LessonAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  quiz            Quiz?
  progress        Progress[]
  comments        Comment[]
  codingExercises CodingExercise[]
  aiJobs          AiProcessingJob[]

  @@unique([slug, courseId])
  @@index([chapterId, order])
  @@index([courseId])
  @@map("lessons")
}

model VideoUpload {
  id           String    @id @default(uuid()) @db.Uuid
  bunnyVideoId String    @unique @map("bunny_video_id") @db.VarChar(100)
  title        String    @db.VarChar(255)
  status       String    @default("CREATED") @map("status") @db.VarChar(50)
  courseId     String    @map("course_id") @db.Uuid
  chapterId    String?   @map("chapter_id") @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  duration     Int       @default(0)
  uploadUrl    String?   @map("upload_url") @db.Text
  expiresAt    DateTime? @map("expires_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([courseId])
  @@index([userId])
  @@map("video_uploads")
}

model Quiz {
  id           String   @id @default(uuid()) @db.Uuid
  title        String   @db.VarChar(255)
  description  String   @default("") @db.Text
  duration     Int      @default(0)
  passingGrade Int      @default(0) @map("passing_grade")
  lessonId     String   @unique @map("lesson_id") @db.Uuid
  courseId     String   @map("course_id") @db.Uuid
  createdById  String   @map("created_by_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  lesson      Lesson           @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  course      Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  createdBy   User             @relation("QuizCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  questions   Question[]
  submissions QuizSubmission[]

  @@index([courseId])
  @@map("quizzes")
}

model Question {
  id        String       @id @default(uuid()) @db.Uuid
  quizId    String       @map("quiz_id") @db.Uuid
  type      QuestionType @default(MULTIPLE_CHOICE)
  title     String       @db.Text
  answer    String       @db.Text
  points    Int          @default(1)
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  quiz              Quiz                   @relation(fields: [quizId], references: [id], onDelete: Cascade)
  options           QuestionOption[]
  submissionAnswers QuizSubmissionAnswer[]

  @@index([quizId])
  @@map("questions")
}

model QuestionOption {
  id         String @id @default(uuid()) @db.Uuid
  questionId String @map("question_id") @db.Uuid
  optionText String @map("option_text") @db.Text
  order      Int    @default(0)

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId, order])
  @@map("question_options")
}

model QuizSubmission {
  id          String   @id @default(uuid()) @db.Uuid
  quizId      String   @map("quiz_id") @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  score       Int      @default(0)
  totalPoints Int      @default(0) @map("total_points")
  percentage  Int      @default(0)
  completedAt DateTime @default(now()) @map("completed_at")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  quiz    Quiz                   @relation(fields: [quizId], references: [id], onDelete: Cascade)
  user    User                   @relation(fields: [userId], references: [id], onDelete: Restrict)
  answers QuizSubmissionAnswer[]

  @@unique([quizId, userId])
  @@index([userId])
  @@map("quiz_submissions")
}

model QuizSubmissionAnswer {
  id             String  @id @default(uuid()) @db.Uuid
  submissionId   String  @map("submission_id") @db.Uuid
  questionId     String  @map("question_id") @db.Uuid
  selectedAnswer String  @map("selected_answer") @db.Text
  isCorrect      Boolean @default(false) @map("is_correct")

  submission QuizSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  question   Question       @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([submissionId])
  @@index([questionId])
  @@map("quiz_submission_answers")
}

model Order {
  id             String       @id @default(uuid()) @db.Uuid
  code           String       @unique @db.VarChar(50)
  amount         Decimal      @db.Decimal(12, 2)
  discount       Decimal      @default(0) @db.Decimal(12, 2)
  total          Decimal      @db.Decimal(12, 2)
  couponId       String?      @map("coupon_id") @db.Uuid
  courseId       String?      @map("course_id") @db.Uuid
  userId         String       @map("user_id") @db.Uuid
  status         EOrderStatus @default(PENDING)
  rejectedReason String?      @map("rejected_reason") @db.Text
  rejectedAt     DateTime?    @map("rejected_at")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  coupon Coupon? @relation(fields: [couponId], references: [id], onDelete: SetNull)
  course Course? @relation(fields: [courseId], references: [id], onDelete: SetNull)
  user   User    @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, courseId, status])
  @@index([courseId])
  @@map("orders")
}

model Coupon {
  id        String      @id @default(uuid()) @db.Uuid
  title     String      @db.VarChar(255)
  code      String      @unique @db.VarChar(100)
  type      ECouponType @default(PERCENTAGE)
  value     Decimal     @db.Decimal(12, 2)
  limit     Int?
  used      Int         @default(0)
  startDate DateTime?   @map("start_date")
  endDate   DateTime?   @map("end_date")
  active    Boolean     @default(false)
  authorId  String?     @map("author_id") @db.Uuid
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")

  author  User?          @relation("CouponAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  orders  Order[]
  courses CouponCourse[]

  @@index([authorId])
  @@map("coupons")
}

model CouponCourse {
  couponId String @map("coupon_id") @db.Uuid
  courseId String @map("course_id") @db.Uuid

  coupon Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@id([couponId, courseId])
  @@map("coupon_courses")
}

model Enrollment {
  id          String            @id @default(uuid()) @db.Uuid
  userId      String            @map("user_id") @db.Uuid
  courseId    String            @map("course_id") @db.Uuid
  progress    Int               @default(0)
  status      EEnrollmentStatus @default(ACTIVE)
  enrolledAt  DateTime          @default(now()) @map("enrolled_at")
  completedAt DateTime?         @map("completed_at")
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")

  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([courseId])
  @@map("enrollments")
}

model Progress {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  courseId  String   @map("course_id") @db.Uuid
  lessonId  String   @map("lesson_id") @db.Uuid
  completed Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@index([courseId])
  @@map("progress")
}

model Certificate {
  id             String   @id @default(uuid()) @db.Uuid
  code           String?  @unique @db.VarChar(50)
  userId         String   @map("user_id") @db.Uuid
  courseId       String   @map("course_id") @db.Uuid
  grade          Decimal  @db.Decimal(5, 2)
  certificateUrl String   @map("certificate_url") @db.Text
  issuedAt       DateTime @default(now()) @map("issued_at")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)
  course Course @relation(fields: [courseId], references: [id], onDelete: Restrict)

  @@unique([userId, courseId])
  @@map("certificates")
}

model Rating {
  id        String        @id @default(uuid()) @db.Uuid
  rate      Int           @db.SmallInt
  content   String        @db.VarChar(255)
  userId    String        @map("user_id") @db.Uuid
  courseId  String        @map("course_id") @db.Uuid
  status    ERatingStatus @default(INACTIVE)
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([courseId, status])
  @@map("ratings")
}

model FavoriteCourse {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  courseId  String   @map("course_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@map("favorite_courses")
}

model Comment {
  id             String        @id @default(uuid()) @db.Uuid
  content        String        @db.Text
  lessonId       String        @map("lesson_id") @db.Uuid
  courseId       String        @map("course_id") @db.Uuid
  userId         String        @map("user_id") @db.Uuid
  parentId       String?       @map("parent_id") @db.Uuid
  level          Int           @default(0)
  status         CommentStatus @default(APPROVED)
  moderationNote String?       @map("moderation_note") @db.Text
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  lesson    Lesson            @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  course    Course            @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent    Comment?          @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   Comment[]         @relation("CommentReplies")
  reactions CommentReaction[]

  @@index([lessonId, status])
  @@index([courseId])
  @@index([parentId])
  @@map("comments")
}

model CommentReaction {
  id        String              @id @default(uuid()) @db.Uuid
  commentId String              @map("comment_id") @db.Uuid
  userId    String              @map("user_id") @db.Uuid
  type      CommentReactionType
  createdAt DateTime            @default(now()) @map("created_at")

  comment Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([commentId, userId])
  @@map("comment_reactions")
}

model Conversation {
  id            String   @id @default(uuid()) @db.Uuid
  isGroup       Boolean  @default(false) @map("is_group")
  name          String?  @db.VarChar(255)
  courseId      String?  @map("course_id") @db.Uuid
  lastMessageId String?  @map("last_message_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  course       Course?                   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  participants ConversationParticipant[]
  messages     Message[]

  @@map("conversations")
}

model ConversationParticipant {
  conversationId String   @map("conversation_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  joinedAt       DateTime @default(now()) @map("joined_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([conversationId, userId])
  @@index([userId])
  @@map("conversation_participants")
}

model Message {
  id             String       @id @default(uuid()) @db.Uuid
  conversationId String       @map("conversation_id") @db.Uuid
  senderId       String       @map("sender_id") @db.Uuid
  content        String       @db.Text
  type           EMessageType @default(TEXT)
  isEdited       Boolean      @default(false) @map("is_edited")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  conversation Conversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User          @relation("MessageSender", fields: [senderId], references: [id], onDelete: Restrict)
  reads        MessageRead[]

  @@index([conversationId, createdAt])
  @@map("messages")
}

model MessageRead {
  messageId String   @map("message_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  readAt    DateTime @default(now()) @map("read_at")

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([messageId, userId])
  @@map("message_reads")
}

model Notification {
  id         String            @id @default(uuid()) @db.Uuid
  senderId   String?           @map("sender_id") @db.Uuid
  receiverId String            @map("receiver_id") @db.Uuid
  type       ENotificationType
  message    String            @db.Text
  relatedId  String?           @map("related_id") @db.VarChar(255)
  metadata   Json?             @map("metadata")
  isRead     Boolean           @default(false) @map("is_read")
  createdAt  DateTime          @default(now()) @map("created_at")
  updatedAt  DateTime          @updatedAt @map("updated_at")

  sender   User? @relation("NotificationSender", fields: [senderId], references: [id], onDelete: SetNull)
  receiver User  @relation("NotificationReceiver", fields: [receiverId], references: [id], onDelete: Cascade)

  @@index([receiverId, isRead, createdAt])
  @@map("notifications")
}

// ==========================================
// CODING EXERCISE MODELS (STEP 1 IMPLEMENTATION)
// ==========================================

model CodingExercise {
  id                  String             @id @default(uuid()) @db.Uuid
  lessonId            String             @map("lesson_id") @db.Uuid
  courseId            String             @map("course_id") @db.Uuid
  title               String             @db.VarChar(255)
  slug                String             @db.VarChar(255)
  description         String             @db.Text
  programmingLanguage String             @default("javascript") @map("programming_language") @db.VarChar(50)
  difficulty          ExerciseDifficulty @default(EASY)
  starterCode         String             @map("starter_code") @db.Text
  referenceSolution   String             @map("reference_solution") @db.Text
  executionContract   Json               @map("execution_contract")
  timeLimit           Int                @default(2000) @map("time_limit")
  memoryLimit         Int                @default(128000) @map("memory_limit")
  status              ExerciseStatus     @default(DRAFT)
  source              ExerciseSource     @default(MANUAL)
  order               Int                @default(0)
  createdById         String             @map("created_by_id") @db.Uuid
  createdAt           DateTime           @default(now()) @map("created_at")
  updatedAt           DateTime           @updatedAt @map("updated_at")

  lesson      Lesson                     @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  course      Course                     @relation(fields: [courseId], references: [id], onDelete: Cascade)
  createdBy   User                       @relation("CodingExerciseCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  revisions   CodingExerciseRevision[]
  submissions CodingSubmission[]
  completions CodingExerciseCompletion[]

  @@unique([lessonId, slug])
  @@index([lessonId, status])
  @@index([lessonId, order])
  @@index([courseId])
  @@index([createdById])
  @@map("coding_exercises")
}

model CodingExerciseRevision {
  id                String   @id @default(uuid()) @db.Uuid
  exerciseId        String   @map("exercise_id") @db.Uuid
  version           Int      @default(1)
  title             String   @db.VarChar(255)
  description       String   @db.Text
  starterCode       String   @map("starter_code") @db.Text
  referenceSolution String   @map("reference_solution") @db.Text
  executionContract Json     @map("execution_contract")
  timeLimit         Int      @default(2000) @map("time_limit")
  memoryLimit       Int      @default(128000) @map("memory_limit")
  isPublished       Boolean  @default(false) @map("is_published")
  createdById       String?  @map("created_by_id") @db.Uuid
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  exercise    CodingExercise     @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  createdBy   User?              @relation("CodingRevisionCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  testCases   CodingTestCase[]
  submissions CodingSubmission[]

  @@unique([exerciseId, version])
  @@index([exerciseId, isPublished])
  @@map("coding_exercise_revisions")
}

model CodingTestCase {
  id             String   @id @default(uuid()) @db.Uuid
  revisionId     String   @map("revision_id") @db.Uuid
  input          Json     @map("input")
  expectedOutput Json     @map("expected_output")
  isHidden       Boolean  @default(false) @map("is_hidden")
  order          Int      @default(0)
  weight         Int      @default(1)
  explanation    String?  @db.Text
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  revision    CodingExerciseRevision @relation(fields: [revisionId], references: [id], onDelete: Cascade)
  testResults CodingTestResult[]

  @@index([revisionId, order])
  @@index([revisionId, isHidden])
  @@map("coding_test_cases")
}

model CodingSubmission {
  id                String           @id @default(uuid()) @db.Uuid
  exerciseId        String           @map("exercise_id") @db.Uuid
  revisionId        String           @map("revision_id") @db.Uuid
  userId            String           @map("user_id") @db.Uuid
  sourceCode        String           @map("source_code") @db.Text
  language          String           @default("javascript") @db.VarChar(50)
  status            SubmissionStatus @default(PENDING)
  score             Int              @default(0)
  maxScore          Int              @default(100) @map("max_score")
  passedTests       Int              @default(0) @map("passed_tests")
  totalTests        Int              @default(0) @map("total_tests")
  judgeSubmissionId String?          @map("judge_submission_id") @db.VarChar(100)
  executionTime     Int?             @map("execution_time")
  memoryUsage       Int?             @map("memory_usage")
  errorMessage      String?          @map("error_message") @db.Text
  createdAt         DateTime         @default(now()) @map("created_at")
  completedAt       DateTime?        @map("completed_at")

  exercise    CodingExercise             @relation(fields: [exerciseId], references: [id], onDelete: Restrict)
  revision    CodingExerciseRevision     @relation(fields: [revisionId], references: [id], onDelete: Restrict)
  user        User                       @relation(fields: [userId], references: [id], onDelete: Restrict)
  results     CodingTestResult[]
  completions CodingExerciseCompletion[]

  @@index([userId, exerciseId, createdAt])
  @@index([exerciseId, status])
  @@index([revisionId])
  @@index([userId, status])
  @@index([judgeSubmissionId])
  @@map("coding_submissions")
}

model CodingTestResult {
  id            String         @id @default(uuid()) @db.Uuid
  submissionId  String         @map("submission_id") @db.Uuid
  testCaseId    String         @map("test_case_id") @db.Uuid
  status        TestCaseStatus
  actualOutput  Json?          @map("actual_output")
  executionTime Int?           @map("execution_time")
  memoryUsage   Int?           @map("memory_usage")
  errorMessage  String?        @map("error_message") @db.Text
  stdout        String?        @db.Text

  submission CodingSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  testCase   CodingTestCase   @relation(fields: [testCaseId], references: [id], onDelete: Restrict)

  @@unique([submissionId, testCaseId])
  @@index([submissionId])
  @@index([testCaseId])
  @@map("coding_test_results")
}

model CodingExerciseCompletion {
  id                        String   @id @default(uuid()) @db.Uuid
  userId                    String   @map("user_id") @db.Uuid
  exerciseId                String   @map("exercise_id") @db.Uuid
  firstAcceptedSubmissionId String   @map("first_accepted_submission_id") @db.Uuid
  completedAt               DateTime @default(now()) @map("completed_at")
  bestScore                 Int      @default(100) @map("best_score")
  totalAttempts             Int      @default(1) @map("total_attempts")
  xpAwarded                 Int      @default(0) @map("xp_awarded")
  createdAt                 DateTime @default(now()) @map("created_at")
  updatedAt                 DateTime @updatedAt @map("updated_at")

  user                    User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  exercise                CodingExercise   @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  firstAcceptedSubmission CodingSubmission @relation(fields: [firstAcceptedSubmissionId], references: [id], onDelete: Cascade)

  @@unique([userId, exerciseId])
  @@index([userId])
  @@index([exerciseId])
  @@map("coding_exercise_completions")
}

model AiProcessingJob {
  id               String      @id @default(uuid()) @db.Uuid
  lessonId         String      @map("lesson_id") @db.Uuid
  courseId         String      @map("course_id") @db.Uuid
  requestedById    String      @map("requested_by_id") @db.Uuid
  jobType          AiJobType   @default(TRANSCRIBE_AND_SUMMARIZE) @map("job_type")
  status           AiJobStatus @default(PENDING) @map("status")
  providerJobId    String?     @map("provider_job_id") @db.VarChar(100)
  generation       Int         @default(1) @map("generation")
  videoId          String?     @map("video_id") @db.VarChar(100)
  videoFingerprint String?     @map("video_fingerprint") @db.VarChar(255)
  attemptCount     Int         @default(0) @map("attempt_count")
  currentStage     String?     @map("current_stage") @db.VarChar(50)
  startedAt        DateTime?   @map("started_at")
  completedAt      DateTime?   @map("completed_at")
  lastPolledAt     DateTime?   @map("last_polled_at")
  nextPollAt       DateTime?   @map("next_poll_at")
  errorMessage     String?     @map("error_message") @db.Text
  rawMetadata      Json?       @map("raw_metadata")
  createdAt        DateTime    @default(now()) @map("created_at")
  updatedAt        DateTime    @updatedAt @map("updated_at")

  lesson      Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  course      Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  requestedBy User   @relation("UserRequestedAiJobs", fields: [requestedById], references: [id], onDelete: Restrict)

  @@index([lessonId, status])
  @@index([providerJobId])
  @@index([status, nextPollAt])
  @@index([requestedById])
  @@map("ai_processing_jobs")
}

// ==========================================
// TELEGRAM TEACHER BOT MODELS (TG-02A)
// ==========================================

model TelegramAccount {
  id                String   @id @default(uuid()) @db.Uuid
  userId            String   @unique @map("user_id") @db.Uuid
  telegramUserId    BigInt   @unique @map("telegram_user_id")
  telegramChatId    BigInt   @map("telegram_chat_id")
  telegramUsername  String?  @map("telegram_username") @db.VarChar(100)
  telegramFirstName String?  @map("telegram_first_name") @db.VarChar(100)
  linkedAt          DateTime @default(now()) @map("linked_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([telegramUserId])
  @@index([userId])
  @@map("telegram_accounts")
}

model TelegramLinkToken {
  id                   String    @id @default(uuid()) @db.Uuid
  userId               String    @map("user_id") @db.Uuid
  tokenHash            String    @unique @map("token_hash") @db.VarChar(64)
  expiresAt            DateTime  @map("expires_at")
  isConsumed           Boolean   @default(false) @map("is_consumed")
  consumedAt           DateTime? @map("consumed_at")
  consumedByTelegramId BigInt?   @map("consumed_by_telegram_id")
  createdAt            DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isConsumed])
  @@index([expiresAt, isConsumed])
  @@index([tokenHash])
  @@map("telegram_link_tokens")
}
