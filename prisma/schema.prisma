generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// ENUMS
// ==========================================

enum UserRole {
  ADMIN   @map("admin")
  USER    @map("user")
  TEACHER @map("teacher")
}

enum UserStatus {
  ACTIVE   @map("active")
  INACTIVE @map("inactive")
}

enum CourseStatus {
  APPROVED @map("approved")
  PENDING  @map("pending")
  REJECTED @map("rejected")
}

enum CourseLevel {
  BEGINNER     @map("beginner")
  INTERMEDIATE @map("intermediate")
  ADVANCED     @map("advanced")
}

enum CourseType {
  PAID @map("paid")
  FREE @map("free")
}

enum LessonType {
  VIDEO @map("video")
  TEXT  @map("text")
}

enum ECouponType {
  PERCENTAGE @map("percentage")
  NUMBER     @map("number")
}

enum EOrderStatus {
  PENDING   @map("pending")
  COMPLETED @map("completed")
  REJECTED  @map("rejected")
}

enum EEnrollmentStatus {
  ACTIVE    @map("active")
  COMPLETED @map("completed")
  CANCELED  @map("canceled")
}

enum CommentStatus {
  APPROVED @map("approved")
  PENDING  @map("pending")
  REJECTED @map("rejected")
}

enum ERatingStatus {
  ACTIVE   @map("active")
  INACTIVE @map("inactive")
}

enum ENotificationType {
  COMMENT       @map("comment")
  RATING        @map("rating")
  ORDER         @map("order")
  MESSAGE       @map("message")
  SYSTEM        @map("system")
  COURSE        @map("course")
  LESSON        @map("lesson")
  COMMENT_REPLY @map("comment_reply")
  QUIZ          @map("quiz")
}

enum QuestionType {
  MULTIPLE_CHOICE @map("multiple_choice")
  FILL_IN_BLANK   @map("fill_in_blank")
}

enum EMessageType {
  TEXT  @map("text")
  IMAGE @map("image")
  FILE  @map("file")
}

enum CommentReactionType {
  LIKE    @map("like")
  DISLIKE @map("dislike")
}

// ==========================================
// MODELS
// ==========================================

model User {
  id                   String     @id @default(uuid()) @db.Uuid
  username             String     @db.VarChar(100)
  email                String     @unique @db.VarChar(255)
  password             String     @db.VarChar(255)
  status               UserStatus @default(ACTIVE)
  role                 UserRole   @default(USER)
  avatar               String     @default("")
  phone                String?    @db.VarChar(30)
  bio                  String?    @db.Text
  socialFacebook       String     @default("") @map("social_facebook")
  socialInstagram      String     @default("") @map("social_instagram")
  socialGithub         String     @default("") @map("social_github")
  isVerified           Boolean    @default(false) @map("is_verified")
  otpCode              String?    @map("otp_code") @db.VarChar(255)
  otpExpires           DateTime?  @map("otp_expires")
  refreshToken         String?    @map("refresh_token") @db.Text
  resetPasswordToken   String?    @map("reset_password_token") @db.Text
  resetPasswordExpires DateTime?  @map("reset_password_expires")
  createdAt            DateTime   @default(now()) @map("created_at")
  updatedAt            DateTime   @updatedAt @map("updated_at")

  // Relations
  createdCategories     Category[]                @relation("CategoryCreatedBy")
  authoredCourses       Course[]                  @relation("CourseAuthor")
  authoredLessons       Lesson[]                  @relation("LessonAuthor")
  createdQuizzes        Quiz[]                    @relation("QuizCreatedBy")
  quizSubmissions       QuizSubmission[]
  orders                Order[]
  authoredCoupons       Coupon[]                  @relation("CouponAuthor")
  enrollments           Enrollment[]
  progress              Progress[]
  certificates          Certificate[]
  ratings               Rating[]
  comments              Comment[]
  commentReactions      CommentReaction[]
  favoriteCourses       FavoriteCourse[]
  conversations         ConversationParticipant[]
  sentMessages          Message[]                 @relation("MessageSender")
  messageReads          MessageRead[]
  sentNotifications     Notification[]            @relation("NotificationSender")
  receivedNotifications Notification[]            @relation("NotificationReceiver")

  @@index([role])
  @@index([status])
  @@index([isVerified])
  @@map("users")
}

model Category {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique @db.VarChar(200)
  slug        String   @unique @db.VarChar(250)
  description String?  @db.Text
  createdById String?  @map("created_by_id") @db.Uuid
  isDestroyed Boolean  @default(false) @map("is_destroyed")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  createdBy User?    @relation("CategoryCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  courses   Course[]

  @@map("categories")
}

model Course {
  id           String       @id @default(uuid()) @db.Uuid
  title        String       @db.VarChar(255)
  slug         String       @unique @db.VarChar(255)
  image        String       @default("")
  introUrl     String       @default("") @map("intro_url")
  description  String       @default("") @db.Text
  price        Decimal      @default(0) @db.Decimal(12, 2)
  oldPrice     Decimal      @default(0) @map("old_price") @db.Decimal(12, 2)
  type         CourseType   @default(PAID)
  status       CourseStatus @default(PENDING)
  level        CourseLevel  @default(BEGINNER)
  view         Int          @default(0)
  sold         Int          @default(0)
  requirements String[]     @default([])
  benefits     String[]     @default([])
  techniques   String[]     @default([])
  documents    String[]     @default([])
  categoryId   String?      @map("category_id") @db.Uuid
  authorId     String       @map("author_id") @db.Uuid
  isDestroyed  Boolean      @default(false) @map("is_destroyed")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  category        Category?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  author          User             @relation("CourseAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  faqs            CourseFaq[]
  chapters        Chapter[]
  lessons         Lesson[]
  quizzes         Quiz[]
  orders          Order[]
  coupons         CouponCourse[]
  enrollments     Enrollment[]
  progress        Progress[]
  certificates    Certificate[]
  ratings         Rating[]
  comments        Comment[]
  favoriteByUsers FavoriteCourse[]
  conversations   Conversation[]

  @@index([authorId])
  @@index([categoryId])
  @@index([status, isDestroyed])
  @@map("courses")
}

model CourseFaq {
  id        String   @id @default(uuid()) @db.Uuid
  courseId  String   @map("course_id") @db.Uuid
  question  String   @db.Text
  answer    String   @db.Text
  order     Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([courseId, order])
  @@map("course_faqs")
}

model Chapter {
  id          String   @id @default(uuid()) @db.Uuid
  title       String   @db.VarChar(255)
  courseId    String   @map("course_id") @db.Uuid
  order       Int      @default(0)
  isDestroyed Boolean  @default(false) @map("is_destroyed")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  course  Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons Lesson[]

  @@index([courseId, order])
  @@map("chapters")
}

model Lesson {
  id        String     @id @default(uuid()) @db.Uuid
  title     String     @db.VarChar(255)
  slug      String     @db.VarChar(255)
  chapterId String     @map("chapter_id") @db.Uuid
  courseId  String     @map("course_id") @db.Uuid
  authorId  String     @map("author_id") @db.Uuid
  order     Int        @default(0)
  duration  Int        @default(0)
  type      LessonType @default(VIDEO)
  content   String     @default("") @db.Text
  isDemo    Boolean    @default(false) @map("is_demo")
  videoUrl  String     @default("") @map("video_url")
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")

  chapter  Chapter    @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  course   Course     @relation(fields: [courseId], references: [id], onDelete: Cascade)
  author   User       @relation("LessonAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  quiz     Quiz?
  progress Progress[]
  comments Comment[]

  @@unique([slug, courseId])
  @@index([chapterId, order])
  @@index([courseId])
  @@map("lessons")
}

model Quiz {
  id           String   @id @default(uuid()) @db.Uuid
  title        String   @db.VarChar(255)
  description  String   @default("") @db.Text
  duration     Int      @default(0)
  passingGrade Int      @default(0) @map("passing_grade")
  lessonId     String   @unique @map("lesson_id") @db.Uuid
  courseId     String   @map("course_id") @db.Uuid
  createdById  String   @map("created_by_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  lesson      Lesson           @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  course      Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  createdBy   User             @relation("QuizCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  questions   Question[]
  submissions QuizSubmission[]

  @@index([courseId])
  @@map("quizzes")
}

model Question {
  id        String       @id @default(uuid()) @db.Uuid
  quizId    String       @map("quiz_id") @db.Uuid
  type      QuestionType @default(MULTIPLE_CHOICE)
  title     String       @db.Text
  answer    String       @db.Text
  points    Int          @default(1)
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  quiz              Quiz                   @relation(fields: [quizId], references: [id], onDelete: Cascade)
  options           QuestionOption[]
  submissionAnswers QuizSubmissionAnswer[]

  @@index([quizId])
  @@map("questions")
}

model QuestionOption {
  id         String @id @default(uuid()) @db.Uuid
  questionId String @map("question_id") @db.Uuid
  optionText String @map("option_text") @db.Text
  order      Int    @default(0)

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId, order])
  @@map("question_options")
}

model QuizSubmission {
  id          String   @id @default(uuid()) @db.Uuid
  quizId      String   @map("quiz_id") @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  score       Int      @default(0)
  totalPoints Int      @default(0) @map("total_points")
  percentage  Int      @default(0)
  completedAt DateTime @default(now()) @map("completed_at")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  quiz    Quiz                   @relation(fields: [quizId], references: [id], onDelete: Cascade)
  user    User                   @relation(fields: [userId], references: [id], onDelete: Restrict)
  answers QuizSubmissionAnswer[]

  @@unique([quizId, userId])
  @@index([userId])
  @@map("quiz_submissions")
}

model QuizSubmissionAnswer {
  id             String  @id @default(uuid()) @db.Uuid
  submissionId   String  @map("submission_id") @db.Uuid
  questionId     String  @map("question_id") @db.Uuid
  selectedAnswer String  @map("selected_answer") @db.Text
  isCorrect      Boolean @default(false) @map("is_correct")

  submission QuizSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  question   Question       @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([submissionId])
  @@index([questionId])
  @@map("quiz_submission_answers")
}

model Order {
  id        String       @id @default(uuid()) @db.Uuid
  code      String       @unique @db.VarChar(50)
  amount    Decimal      @db.Decimal(12, 2)
  discount  Decimal      @default(0) @db.Decimal(12, 2)
  total     Decimal      @db.Decimal(12, 2)
  couponId  String?      @map("coupon_id") @db.Uuid
  courseId  String?      @map("course_id") @db.Uuid
  userId    String       @map("user_id") @db.Uuid
  status    EOrderStatus @default(PENDING)
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  coupon Coupon? @relation(fields: [couponId], references: [id], onDelete: SetNull)
  course Course? @relation(fields: [courseId], references: [id], onDelete: SetNull)
  user   User    @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, courseId, status])
  @@index([courseId])
  @@map("orders")
}

model Coupon {
  id        String      @id @default(uuid()) @db.Uuid
  title     String      @db.VarChar(255)
  code      String      @unique @db.VarChar(100)
  type      ECouponType @default(PERCENTAGE)
  value     Decimal     @db.Decimal(12, 2)
  limit     Int?
  used      Int         @default(0)
  startDate DateTime?   @map("start_date")
  endDate   DateTime?   @map("end_date")
  active    Boolean     @default(false)
  authorId  String?     @map("author_id") @db.Uuid
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")

  author  User?          @relation("CouponAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  orders  Order[]
  courses CouponCourse[]

  @@index([authorId])
  @@map("coupons")
}

model CouponCourse {
  couponId String @map("coupon_id") @db.Uuid
  courseId String @map("course_id") @db.Uuid

  coupon Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@id([couponId, courseId])
  @@map("coupon_courses")
}

model Enrollment {
  id          String            @id @default(uuid()) @db.Uuid
  userId      String            @map("user_id") @db.Uuid
  courseId    String            @map("course_id") @db.Uuid
  progress    Int               @default(0)
  status      EEnrollmentStatus @default(ACTIVE)
  enrolledAt  DateTime          @default(now()) @map("enrolled_at")
  completedAt DateTime?         @map("completed_at")
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")

  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([courseId])
  @@map("enrollments")
}

model Progress {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  courseId  String   @map("course_id") @db.Uuid
  lessonId  String   @map("lesson_id") @db.Uuid
  completed Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@index([courseId])
  @@map("progress")
}

model Certificate {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  courseId       String   @map("course_id") @db.Uuid
  grade          Decimal  @db.Decimal(5, 2)
  certificateUrl String   @map("certificate_url") @db.Text
  issuedAt       DateTime @default(now()) @map("issued_at")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)
  course Course @relation(fields: [courseId], references: [id], onDelete: Restrict)

  @@unique([userId, courseId])
  @@map("certificates")
}

model Rating {
  id        String        @id @default(uuid()) @db.Uuid
  rate      Int           @db.SmallInt
  content   String        @db.VarChar(255)
  userId    String        @map("user_id") @db.Uuid
  courseId  String        @map("course_id") @db.Uuid
  status    ERatingStatus @default(INACTIVE)
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([courseId, status])
  @@map("ratings")
}

model FavoriteCourse {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  courseId  String   @map("course_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@map("favorite_courses")
}

model Comment {
  id        String        @id @default(uuid()) @db.Uuid
  content   String        @db.Text
  lessonId  String        @map("lesson_id") @db.Uuid
  courseId  String        @map("course_id") @db.Uuid
  userId    String        @map("user_id") @db.Uuid
  parentId  String?       @map("parent_id") @db.Uuid
  level     Int           @default(0)
  status    CommentStatus @default(APPROVED)
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")

  lesson    Lesson            @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  course    Course            @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent    Comment?          @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   Comment[]         @relation("CommentReplies")
  reactions CommentReaction[]

  @@index([lessonId, status])
  @@index([courseId])
  @@index([parentId])
  @@map("comments")
}

model CommentReaction {
  id        String              @id @default(uuid()) @db.Uuid
  commentId String              @map("comment_id") @db.Uuid
  userId    String              @map("user_id") @db.Uuid
  type      CommentReactionType
  createdAt DateTime            @default(now()) @map("created_at")

  comment Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([commentId, userId])
  @@map("comment_reactions")
}

model Conversation {
  id            String   @id @default(uuid()) @db.Uuid
  isGroup       Boolean  @default(false) @map("is_group")
  name          String?  @db.VarChar(255)
  courseId      String?  @map("course_id") @db.Uuid
  lastMessageId String?  @map("last_message_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  course       Course?                   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  participants ConversationParticipant[]
  messages     Message[]

  @@map("conversations")
}

model ConversationParticipant {
  conversationId String   @map("conversation_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  joinedAt       DateTime @default(now()) @map("joined_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([conversationId, userId])
  @@index([userId])
  @@map("conversation_participants")
}

model Message {
  id             String       @id @default(uuid()) @db.Uuid
  conversationId String       @map("conversation_id") @db.Uuid
  senderId       String       @map("sender_id") @db.Uuid
  content        String       @db.Text
  type           EMessageType @default(TEXT)
  isEdited       Boolean      @default(false) @map("is_edited")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  conversation Conversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User          @relation("MessageSender", fields: [senderId], references: [id], onDelete: Restrict)
  reads        MessageRead[]

  @@index([conversationId, createdAt])
  @@map("messages")
}

model MessageRead {
  messageId String   @map("message_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  readAt    DateTime @default(now()) @map("read_at")

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([messageId, userId])
  @@map("message_reads")
}

model Notification {
  id         String            @id @default(uuid()) @db.Uuid
  senderId   String?           @map("sender_id") @db.Uuid
  receiverId String            @map("receiver_id") @db.Uuid
  type       ENotificationType
  message    String            @db.Text
  relatedId  String?           @map("related_id") @db.VarChar(255)
  isRead     Boolean           @default(false) @map("is_read")
  createdAt  DateTime          @default(now()) @map("created_at")
  updatedAt  DateTime          @updatedAt @map("updated_at")

  sender   User? @relation("NotificationSender", fields: [senderId], references: [id], onDelete: SetNull)
  receiver User  @relation("NotificationReceiver", fields: [receiverId], references: [id], onDelete: Cascade)

  @@index([receiverId, isRead, createdAt])
  @@map("notifications")
}
