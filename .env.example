# ==========================================
# TMDEMY BACKEND ENVIRONMENT CONFIGURATION
# ==========================================

# Target Database (PostgreSQL 16.11 via Prisma ORM)
DATABASE_URL="postgresql://username:password@localhost:5432/tmdemy?schema=public"

# Server Port
PORT=3000

# Client and Server URLs
URL_SERVER="http://localhost:3000"
URL_CLIENT="http://localhost:5173"

# JWT Secrets & Expiration
JWT_SECRECT_ACCESS_TOKEN="your_jwt_access_secret_here"
JWT_SECRECT_REFRESH_TOKEN="your_jwt_refresh_secret_here"
JWT_SECRET_VERIFIED_EMAIL="your_jwt_verification_secret_here"
VERIFIED_EMAIL_JWT_EXPIRES_IN="15m"

# Email Configuration (Nodemailer / SMTP)
EMAIL_NAME="your_email@gmail.com"
EMAIL_APP_PASSWORD="your_app_specific_password"

# Unverified User Cleanup Cron Settings
UNVERIFIED_USER_EXPIRE_MINUTES="1440"
UNVERIFIED_USER_CRON_EXPRESSION="0 0 * * *"

# Cloudinary Storage Configuration
CLOUDINARY_URL="cloudinary://api_key:api_secret@cloud_name"

# Google OAuth2 Credentials
CLIENT_ID="your_google_client_id.apps.googleusercontent.com"
CLIENT_SECRET="your_google_client_secret"

# Bunny Stream Configuration (Direct Video Upload & Hosting)
# Server-side only: NEVER expose BUNNY_API_KEY to client/frontend
BUNNY_API_KEY="your_bunny_stream_api_key_here"
# The Numeric Video Library ID from Bunny.net Stream Dashboard
BUNNY_LIBRARY_ID="your_bunny_library_id_here"
# The CDN Pull Zone Hostname for HLS and Thumbnails (e.g. vz-xxxx.b-cdn.net)
BUNNY_CDN_HOSTNAME="your_pull_zone_hostname.b-cdn.net"
# Token Authentication Security Key from Bunny Pull Zone / Stream Security Tab
# Required for signed direct MP4 video downloads and secure FastAPI AI processing (Token Auth V2)
BUNNY_TOKEN_SECURITY_KEY="your_token_authentication_security_key_here"

# ==========================================
# E2B SANDBOX CONFIGURATION (STEP 3 MIGRATION)
# ==========================================
# E2B API Key (Obtain from https://e2b.dev/dashboard)
E2B_API_KEY="your_e2b_api_key_here"
# Optional Sandbox Template ID/alias (Leave empty to use official base Node.js template)
E2B_TEMPLATE=""
# Sandbox MicroVM Lifespan Timeout (ms, default: 60000ms / 60s)
E2B_SANDBOX_TIMEOUT_MS="60000"
# Maximum Execution Time per Test Case Command (ms, default: 10000ms / 10s)
E2B_COMMAND_TIMEOUT_MS="10000"
# Maximum concurrent executions per test suite (default: 2)
E2B_MAX_CONCURRENCY="2"

# ==========================================
# FASTAPI AI MICROSERVICE CONFIGURATION (STEP 6.6A)
# ==========================================
# Base URL of the FastAPI AI Microservice (e.g., http://127.0.0.1:8000)
AI_SERVICE_URL="http://127.0.0.1:8000"
# Shared secret for outbound Node.js -> FastAPI requests (Sent as X-API-Key header)
# Required for AI job creation and result retrieval. Never hardcode fallback.
AI_SERVICE_API_KEY="your_ai_service_secret_key_here"
# Optional separate secret for inbound FastAPI -> Node.js callbacks (Header: x-ai-service-key)
# Falls back to AI_SERVICE_API_KEY if not specified.
AI_SERVICE_CALLBACK_SECRET="your_ai_service_callback_secret_here"
# HTTP Client request timeout in milliseconds (default: 30000ms / 30s)
AI_SERVICE_TIMEOUT_MS="30000"
# Background job polling interval in milliseconds (default: 5000ms / 5s)
AI_JOB_POLL_INTERVAL_MS="5000"
# Maximum number of polling attempts before marking job FAILED (default: 60 attempts = 5 mins)
AI_JOB_MAX_POLL_ATTEMPTS="60"
# Periodic AI Job Reconciliation Cron Settings (Step 6.6C)
AI_JOB_RECONCILIATION_ENABLED="true"
AI_JOB_RECONCILIATION_CRON="*/30 * * * * *"
AI_JOB_RECONCILIATION_BATCH_SIZE="10"



# ==========================================
# PYTHON RECOMMENDATION MICROSERVICE (REC-09)
# ==========================================
# Base URL of the Python Recommendation Microservice (FastAPI)
RECOMMENDATION_SERVICE_URL="http://127.0.0.1:8000"
# Shared secret for outbound Node.js -> Python requests (Header: X-API-Key)
RECOMMENDATION_API_KEY="your_recommendation_api_key_here"
# Request timeout in milliseconds (default: 5000ms / 5s)
RECOMMENDATION_TIMEOUT_MS="5000"
# Feature flag to enable or disable recommendation calls
RECOMMENDATION_ENABLED="true"


# ==========================================
# TELEGRAM TEACHER ANALYTICS BOT (TG-01)
# ==========================================
# Telegram Bot API Token obtained from @BotFather
# Example format: 123456789:ABCdefGHIjklMNOpqrSTUvwxYZ
TELEGRAM_BOT_TOKEN="your_telegram_bot_token_here"
# Master switch to enable or disable the Telegram Bot long-polling service (true | false)
TELEGRAM_BOT_ENABLED="true"
