# ==========================================
# TMDEMY BACKEND ENVIRONMENT CONFIGURATION
# ==========================================

# Target Database (PostgreSQL 16.11 via Prisma ORM)
DATABASE_URL="postgresql://username:password@localhost:5432/tmdemy?schema=public"

# Server Port
PORT=3000

# Client and Server URLs
URL_SERVER="http://localhost:3000"
URL_CLIENT="http://localhost:5173"

# JWT Secrets & Expiration
JWT_SECRECT_ACCESS_TOKEN="your_jwt_access_secret_here"
JWT_SECRECT_REFRESH_TOKEN="your_jwt_refresh_secret_here"
JWT_SECRET_VERIFIED_EMAIL="your_jwt_verification_secret_here"
VERIFIED_EMAIL_JWT_EXPIRES_IN="15m"

# Email Configuration (Nodemailer / SMTP)
EMAIL_NAME="your_email@gmail.com"
EMAIL_APP_PASSWORD="your_app_specific_password"

# Unverified User Cleanup Cron Settings
UNVERIFIED_USER_EXPIRE_MINUTES="1440"
UNVERIFIED_USER_CRON_EXPRESSION="0 0 * * *"

# Cloudinary Storage Configuration
CLOUDINARY_URL="cloudinary://api_key:api_secret@cloud_name"
